/// dsp/block: the `Mono` trait, and the combinators that wire blocks together.
/// The design follows Faust.
///
/// A *block* takes one input sample, gives one output sample, and keeps its own
/// state between calls. A filter, a gain, and a full effect chain are all blocks.
/// `Mono` is the trait for that. The combinators below are blocks made from other
/// blocks, so a signal graph is written as a *type*:
///
///     Faust                      haven            haven type
///     A : B                      serial(a, b)     Serial<A, B>
///     _ <: (A, B) :> _           sum(a, b)        Sum<A, B>
///     A ~ B                      feedback(a, b)   Feedback<A, B>
///     _                          ident()          Ident
///     *(k)                       gain(k)          Gain
///
/// `Serial` chains two blocks of different types. For `N` blocks of the *same*
/// type, which is what a filter cascade is, use `Cascade<B, N>`. It keeps the
/// stages in an inline array instead of a nest.
///
/// A chain of three:
/// ```
///     let chain: Chain3<Biquad, Biquad, Gain> =
///         serial3(Biquad::highpass(80.0, 0.707, sr),
///                 Biquad::peak(2500.0, 1.2, 4.0, sr),
///                 gain(db_to_lin(-3.0)));
///
///     chain.process_block(block);
/// ```
///
/// Cost.
/// Each combinator is a struct that holds its parts by value. Every `process` is
/// monomorphized and inlined, so a nested chain should compile to one flat loop,
/// with no calls and no branches. The result should be the same as a hand-written
/// chain. Nothing here allocates, and nothing is generic over a lifetime, so you
/// can use a chain from an `@alloc(false)` audio callback.
///
/// Changing a part after you build the chain.
/// The parts are public fields, so a block stays tunable:
/// ```
///     chain.a.b.set(Biquad::peak(freq, q, gain_db, sr));
/// ```
///
/// Your own generic procs.
/// A proc of yours can be generic in the same way, and can use the constructors
/// at the end of this file:
/// ```
///     proc padded<A: Mono>(a: A) Serial<Serial<A, Gain>, Gain> {
///         return serial(serial(a, gain(0.5)), gain(2.0));
///     }
/// ```
///
/// One channel only.
/// `Mono` fixes both ends to `f32`. That is why Faust's `,` (two in, two out) is
/// not in the table above. `sum` is the 1-in 1-out reading of it: it sends the
/// input to both parts and adds the two outputs. A trait for any channel count
/// must project an associated type through a type parameter (`A::In`), which
/// haven cannot do yet. Stereo will get its own trait instead of a wait for that.

import filters { Biquad, OnePole }

// --- Mono -----------------------------------------------------------------

/// One sample in, one sample out, with state kept between calls.
///
/// Write `process` and you get the block methods. A type that already has a
/// `process(*self, x: f32) f32` method conforms with an empty block. That is how
/// the filters in `dsp/filters` join, with no forwarding layer:
/// ```
///     extend OnePole: Mono {}
/// ```
pub trait Mono {
    /// Process one sample and advance the state of the block.
    proc process(*self, x: f32) f32;

    /// Process a full block of samples in place, in order.
    ///
    /// This has a default body over `process`, so no implementer writes it. The
    /// loop over an inlined `process` gives the vectorizer a straight-line body.
    proc process_block(*self, block: *[f32]) void {
        let n: u64 = slice_len::<f32>(block);
        let xs: [f32] = *block;
        let i: u64 = 0u64;
        while (i < n) {
            xs[i] = self.process(xs[i]);
            i = i + 1u64;
        }
    }

    /// Read `src` and write the results to `dst`. Stops at the shorter of the
    /// two. Use this form when the input must stay unchanged, for example a dry
    /// path or a parallel bus.
    proc process_into(*self, dst: *[f32], src: *[f32]) void {
        let n: u64 = slice_len::<f32>(dst);
        let m: u64 = slice_len::<f32>(src);
        if (m < n) { n = m; }
        let d: [f32] = *dst;
        let s: [f32] = *src;
        let i: u64 = 0u64;
        while (i < n) {
            d[i] = self.process(s[i]);
            i = i + 1u64;
        }
    }
}

// The filters are already blocks. Their per-sample method has this name and this
// shape, so no adapter is necessary.
// `StateVariable` is not here because it gives four outputs at the same time. It
// is not a one-in one-out block, and it cannot become one.
extend OnePole: Mono {}
extend Biquad: Mono {}

// --- Leaves ---------------------------------------------------------------

/// Passes the input through with no change.
///
/// Use it as the dry side of a `mix`, or as the neutral part when you build a
/// chain conditionally.
pub struct Ident {}

extend Ident: Mono {
    @alloc(false)
    proc process(*self, x: f32) f32 { return x; }
}

/// A constant gain. Faust's `*(k)`.
///
/// `k` is a plain field, so you can set it once per block for a coarse level
/// control. For a *per-sample* ramp, send it through `OnePole`, or through the
/// smoother that this module will get later. If you write `k` every sample, the
/// gain steps, and the signal steps with it.
/// ```
///     let x: Gain = gain(dsp/utils::db_to_lin(-3.0));
/// ```
pub struct Gain {
    /// Linear amplitude multiplier. For decibels, use `dsp/utils::db_to_lin`.
    k: f32,
}

extend Gain: Mono {
    @alloc(false)
    proc process(*self, x: f32) f32 { return self.k * x; }
}

// --- Combinators ----------------------------------------------------------

/// `a`, then `b`. The output of the first goes to the input of the second.
/// Faust's `:`.
///
/// Both parts are held by value, so a `Serial` is the full chain. There is no
/// pointer to follow and nothing to free.
pub struct Serial<A, B> {
    /// The first stage. It gets the input.
    a: A,
    /// The second stage. It gets the output of `a`.
    b: B,
}

extend Serial<A, B>: Mono where A: Mono, B: Mono {
    @alloc(false)
    proc process(*self, x: f32) f32 {
        return self.b.process(self.a.process(x));
    }
}

/// Both parts get the same input, and their outputs are added. Faust's
/// `_ <: (A, B) :> _`.
///
/// This is the 1-in 1-out reading of parallel: a split, then a merge. Put a
/// `gain` on one side to change the balance.
pub struct Sum<A, B> {
    a: A,
    b: B,
}

extend Sum<A, B>: Mono where A: Mono, B: Mono {
    @alloc(false)
    proc process(*self, x: f32) f32 {
        return self.a.process(x) + self.b.process(x);
    }
}

/// A crossfade between two blocks that get the same input:
/// `(1 - wet) * a + wet * b`.
///
/// This is the dry/wet control that each effect needs in the end. If `a` is an
/// `ident()`, you get the usual "how much effect do I hear" knob. With two real
/// blocks, you get a morph between them.
pub struct Mix<A, B> {
    /// Heard at `wet == 0`.
    a: A,
    /// Heard at `wet == 1`.
    b: B,
    /// Blend position, usually in [0, 1]. Values out of that range are not
    /// clamped, because overshoot and undershoot are sometimes useful.
    wet: f32,
}

extend Mix<A, B>: Mono where A: Mono, B: Mono {
    @alloc(false)
    proc process(*self, x: f32) f32 {
        let dry: f32 = self.a.process(x);
        let wet: f32 = self.b.process(x);
        return dry + self.wet * (wet - dry);
    }
}

/// The output of `a`, delayed by one sample and sent back through `b` into the
/// input of `a`. Faust's `~`.
///
/// The one-sample delay makes the loop computable and not circular. Each
/// recursive structure in audio starts here. `b` is the return path, so
/// `feedback(a, gain(0.7))` is a simple decaying loop, and
/// `feedback(a, serial(delay, damping))` is a comb.
///
/// Notes.
/// Unstable feedback (gain >= 1.0) will blow up. Decaying signals can also make
/// denormals, which are slow on some CPUs. See `dsp/denormal` for details and
/// solutions.
pub struct Feedback<A, B> {
    /// The forward block. It gets the input plus the return of the loop.
    a: A,
    /// The return path, applied to the previous output.
    b: B,
    /// The one-sample delay: the output of `a` from the previous call.
    z1: f32,
}

extend Feedback<A, B>: Mono where A: Mono, B: Mono {
    @alloc(false)
    proc process(*self, x: f32) f32 {
        let y: f32 = self.a.process(x + self.b.process(self.z1));
        self.z1 = y;
        return y;
    }
}

// --- N of a kind ----------------------------------------------------------

/// `N` stages of one block type in series, kept in an inline array.
///
/// This is the array form of `Serial`, for when all stages have the same type. A
/// 4th-order Linkwitz-Riley is two matched biquads, a diffuser is a run of
/// allpasses, and an EQ bank is a row of peaking sections. A nest of `Serial`
/// also works, but it gives a different type for each length, and it puts the
/// count in the shape of the type. `Cascade` keeps one type and names the count.
///
/// `N` is a const parameter, so the loop has a compile-time trip count. It leaves
/// no more in the object code than the equivalent nest.
/// ```
///     let lr4: Cascade<Biquad, 2> =
///         cascade([Biquad::lowpass(f, 0.707, sr),
///                  Biquad::lowpass(f, 0.707, sr)]);
/// ```
pub struct Cascade<B, const N: u64> {
    /// The stages, applied in index order. They are a field like any other part,
    /// so `c.stages[0].set(...)` tunes one stage in place.
    stages: [B; N],
}

extend Cascade<B, N>: Mono where B: Mono {
    @alloc(false)
    proc process(*self, x: f32) f32 {
        let y: f32 = x;
        let i: u64 = 0u64;
        while (i < N) {
            y = self.stages[i].process(y);
            i = i + 1u64;
        }
        return y;
    }
}

// --- Constructors ---------------------------------------------------------
//
// These are free procs, not associated functions. The type arguments come from
// the values, so `serial(lp, hp)` needs no turbofish, while
// `Serial::<OnePole, Biquad>::new(lp, hp)` repeats what the arguments say. They
// also read like the operators they stand for.

/// The identity block. Faust's `_`.
pub proc ident() Ident { return Ident {}; }

/// A constant gain of `k`, linear and not decibels. Faust's `*(k)`.
pub proc gain(k: f32) Gain { return Gain { k: k }; }

/// `a`, then `b`. Faust's `a : b`.
pub proc serial<A: Mono, B: Mono>(a: A, b: B) Serial<A, B> {
    return Serial { a: a, b: b };
}

pub proc serial3<A: Mono, B: Mono, C: Mono>(a: A, b: B, c: C) Serial<Serial<A, B>, C> {
    return Serial { a: Serial { a: a, b: b }, b: c };
}
pub proc serial4<A: Mono, B: Mono, C: Mono, D: Mono>(a: A, b: B, c: C, d: D) Serial<Serial<Serial<A, B>, C>, D> {
    return Serial { a: Serial { a: Serial { a: a, b: b }, b: c }, b: d };
}

/// Both get the same input, outputs added. Faust's `_ <: (a, b) :> _`.
pub proc sum<A: Mono, B: Mono>(a: A, b: B) Sum<A, B> {
    return Sum { a: a, b: b };
}

/// Crossfade from `a` (at `wet == 0`) to `b` (at `wet == 1`). Both get the same
/// input.
pub proc mix<A: Mono, B: Mono>(a: A, b: B, wet: f32) Mix<A, B> {
    return Mix { a: a, b: b, wet: wet };
}

/// `a` with its output fed back through `b` into its input, one sample later.
/// Faust's `a ~ b`.
pub proc feedback<A: Mono, B: Mono>(a: A, b: B) Feedback<A, B> {
    return Feedback { a: a, b: b, z1: 0.0 };
}

/// `N` stages of one block type in series, applied in index order.
///
/// Both parameters come from the array, so you write neither twice. The array is
/// passed by value and copied into the `Cascade`. That cost occurs at
/// construction and not in the per-sample path.
pub proc cascade<B: Mono, const N: u64>(stages: [B; N]) Cascade<B, N> {
    return Cascade { stages: stages };
}
