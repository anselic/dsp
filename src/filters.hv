/// dsp/filters: audio filters.
///
/// Three filter types, from cheapest to most capable: a one-pole lowpass, a
/// biquad with the usual RBJ EQ responses (lowpass, highpass, bandpass, notch,
/// peaking, shelves), and a state-variable filter that gives lowpass, highpass,
/// bandpass and notch at the same time.
///
/// All three are used in the same way. Build one with a constructor, where
/// `cutoff` and `sr` are in hertz, then call `.process` once for each input
/// sample. The state is in the filter struct, so keep the struct between
/// samples. Single precision only.

import std/math { expf, cosf, sinf, tanf, sqrtf, powf, pi_f32, tau_f32 }

/// A one-pole lowpass. One multiply-add for each sample, which is the cheapest
/// smoother that is still usable. Use it to de-zipper control signals and for
/// gentle tone shaping.
// difference equation: y = a0*x + b1*y[-1]. b1 = exp(-2*pi*fc/sr) sets the pole,
// and a0 = 1 - b1 gives unity gain at DC.
pub struct OnePole {
    a0: f32,
    b1: f32,
    z1: f32, // previous output

    /// A one-pole lowpass with corner frequency `cutoff` hertz at sample rate `sr`.
    pub proc lowpass(cutoff: f32, sr: f32) OnePole {
        let b1: f32 = expf(-tau_f32() * cutoff / sr);
        return OnePole { a0: 1.0 - b1, b1: b1, z1: 0.0 };
    }

    /// Tune to corner frequency `cutoff` at sample rate `sr`.
    pub proc set_cutoff(*self, cutoff: f32, sr: f32) {
        self.b1 = expf(-tau_f32() * cutoff / sr);
        self.a0 = 1.0 - self.b1;
    }

    /// Filter one input sample `x` and return the output.
    @alloc(false)
    pub proc process(*self, x: f32) f32 {
        self.z1 = self.a0 * x + self.b1 * self.z1;
        return self.z1;
    }
}

/// A second-order (biquad) section. The constructors below give the common EQ
/// responses. This is the basic part of parametric EQs and crossovers. For a
/// steeper slope, chain more than one.
// transposed direct-form II. the coefficients come from the RBJ audio-EQ
// cookbook and are stored a0-normalized. `from` does the normalization and sets
// the state to zero.
pub struct Biquad {
    b0: f32, b1: f32, b2: f32,
    a1: f32, a2: f32,
    s1: f32, s2: f32, // transposed DF-II state

    /// Build a biquad from the raw coefficients `b0..a2`. Normalizes by `a0` and
    /// starts with zero state. The response constructors below all use this.
    pub proc from(b0: f32, b1: f32, b2: f32, a0: f32, a1: f32, a2: f32) Biquad {
        return Biquad {
            b0: b0 / a0, b1: b1 / a0, b2: b2 / a0,
            a1: a1 / a0, a2: a2 / a0,
            s1: 0.0, s2: 0.0,
        };
    }

    /// Lowpass at `cutoff` hertz with resonance `q`, for sample rate `sr`.
    pub proc lowpass(cutoff: f32, q: f32, sr: f32) Biquad {
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            (1.0 - cs) / 2.0, 1.0 - cs, (1.0 - cs) / 2.0,
            1.0 + alpha, -2.0 * cs, 1.0 - alpha);
    }

    /// Highpass at `cutoff` hertz with resonance `q`, for sample rate `sr`.
    pub proc highpass(cutoff: f32, q: f32, sr: f32) Biquad {
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            (1.0 + cs) / 2.0, -(1.0 + cs), (1.0 + cs) / 2.0,
            1.0 + alpha, -2.0 * cs, 1.0 - alpha);
    }

    /// Bandpass with center at `cutoff` hertz. `q` sets the width. The peak gain
    /// is normalized to 0 dB. For sample rate `sr`.
    pub proc bandpass(cutoff: f32, q: f32, sr: f32) Biquad {
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            alpha, 0.0, -alpha,
            1.0 + alpha, -2.0 * cs, 1.0 - alpha);
    }

    /// Notch (band-reject) at `cutoff` hertz. `q` sets the width. For sample
    /// rate `sr`.
    pub proc notch(cutoff: f32, q: f32, sr: f32) Biquad {
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            1.0, -2.0 * cs, 1.0,
            1.0 + alpha, -2.0 * cs, 1.0 - alpha);
    }

    /// Peaking EQ. Boosts or cuts by `gain_db` at `cutoff` hertz. `q` sets the
    /// bandwidth. For sample rate `sr`.
    pub proc peak(cutoff: f32, q: f32, gain_db: f32, sr: f32) Biquad {
        let a: f32 = powf(10.0, gain_db / 40.0);
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        return Biquad::from(
            1.0 + alpha * a, -2.0 * cs, 1.0 - alpha * a,
            1.0 + alpha / a, -2.0 * cs, 1.0 - alpha / a);
    }

    /// Low shelf. Boosts or cuts by `gain_db` below `cutoff` hertz. `q` sets the
    /// slope. For sample rate `sr`.
    pub proc lowshelf(cutoff: f32, q: f32, gain_db: f32, sr: f32) Biquad {
        let a: f32 = powf(10.0, gain_db / 40.0);
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        let ta: f32 = 2.0 * sqrtf(a) * alpha;
        return Biquad::from(
            a * ((a + 1.0) - (a - 1.0) * cs + ta),
            2.0 * a * ((a - 1.0) - (a + 1.0) * cs),
            a * ((a + 1.0) - (a - 1.0) * cs - ta),
            (a + 1.0) + (a - 1.0) * cs + ta,
            -2.0 * ((a - 1.0) + (a + 1.0) * cs),
            (a + 1.0) + (a - 1.0) * cs - ta);
    }

    /// High shelf. Boosts or cuts by `gain_db` above `cutoff` hertz. `q` sets
    /// the slope. For sample rate `sr`.
    pub proc highshelf(cutoff: f32, q: f32, gain_db: f32, sr: f32) Biquad {
        let a: f32 = powf(10.0, gain_db / 40.0);
        let w: f32 = tau_f32() * cutoff / sr;
        let cs: f32 = cosf(w);
        let alpha: f32 = sinf(w) / (2.0 * q);
        let ta: f32 = 2.0 * sqrtf(a) * alpha;
        return Biquad::from(
            a * ((a + 1.0) + (a - 1.0) * cs + ta),
            -2.0 * a * ((a - 1.0) + (a + 1.0) * cs),
            a * ((a + 1.0) + (a - 1.0) * cs - ta),
            (a + 1.0) - (a - 1.0) * cs + ta,
            2.0 * ((a - 1.0) - (a + 1.0) * cs),
            (a + 1.0) - (a - 1.0) * cs - ta);
    }

    /// Take the response of `other` and keep the running state. This lets you
    /// move a filter while it runs. A new filter would give a discontinuity.
    ///
    ///     f.set(Biquad::lowpass(cutoff, q, sr));
    pub proc set(*self, other: Biquad) {
        self.b0 = other.b0;
        self.b1 = other.b1;
        self.b2 = other.b2;
        self.a1 = other.a1;
        self.a2 = other.a2;
    }

    /// Filter one input sample `x` and return the output.
    @alloc(false)
    pub proc process(*self, x: f32) f32 {
        let y: f32 = self.b0 * x + self.s1;
        self.s1 = self.b1 * x - self.a1 * y + self.s2;
        self.s2 = self.b2 * x - self.a2 * y;
        return y;
    }
}

/// The four outputs of a state-variable filter for one sample.
pub struct SvfOut {
    lp: f32,    /// lowpass output
    hp: f32,    /// highpass output
    bp: f32,    /// bandpass output
    notch: f32, /// notch (lowpass + highpass) output
}

/// A state-variable filter. One pass gives lowpass, highpass, bandpass and
/// notch. It stays stable during a sweep, so use it when the cutoff is
/// modulated.
// topology-preserving transform (Zavalishin) design. unlike the classic
// Chamberlin SVF, it stays stable when the cutoff is modulated near Nyquist.
pub struct StateVariable {
    g: f32, // tan(pi * fc / sr)
    k: f32, // damping, = 1 / Q
    a1: f32, a2: f32, a3: f32,
    ic1eq: f32, ic2eq: f32, // integrator states

    /// A state-variable filter at `cutoff` hertz with resonance `q`, for sample
    /// rate `sr`.
    pub proc new(cutoff: f32, q: f32, sr: f32) StateVariable {
        let g: f32 = tanf(pi_f32() * cutoff / sr);
        let k: f32 = 1.0 / q;
        let a1: f32 = 1.0 / (1.0 + g * (g + k));
        let a2: f32 = g * a1;
        let a3: f32 = g * a2;
        return StateVariable { g: g, k: k, a1: a1, a2: a2, a3: a3, ic1eq: 0.0, ic2eq: 0.0 };
    }

    /// Tune to `cutoff` hertz and resonance `q`, for sample rate `sr`. Keeps the
    /// running state.
    pub proc set(*self, cutoff: f32, q: f32, sr: f32) {
        self.g = tanf(pi_f32() * cutoff / sr);
        self.k = 1.0 / q;
        self.a1 = 1.0 / (1.0 + self.g * (self.g + self.k));
        self.a2 = self.g * self.a1;
        self.a3 = self.g * self.a2;
    }

    /// Filter one input sample `x` and return all four responses in an `SvfOut`.
    @alloc(false)
    pub proc process(*self, x: f32) SvfOut {
        let v3: f32 = x - self.ic2eq;
        let v1: f32 = self.a1 * self.ic1eq + self.a2 * v3;
        let v2: f32 = self.ic2eq + self.a2 * self.ic1eq + self.a3 * v3;
        self.ic1eq = 2.0 * v1 - self.ic1eq;
        self.ic2eq = 2.0 * v2 - self.ic2eq;

        let lp: f32 = v2;
        let bp: f32 = v1;
        let hp: f32 = x - self.k * v1 - v2;
        return SvfOut { lp: lp, hp: hp, bp: bp, notch: hp + lp };
    }
}
